# Copy this file to .env before starting Docker if you need to override defaults.
POSTGRES_DB=evd_sys
POSTGRES_USER=evd_user
POSTGRES_PASSWORD=evd_password
POSTGRES_PORT=5432

# Set these in the IDE/run configuration or operating-system environment.
DB_URL=jdbc:postgresql://localhost:5432/evd_sys
DB_USERNAME=evd_user
DB_PASSWORD=evd_password

# Use a Base64-encoded secret representing at least 32 random bytes in a real environment.
# Example Base64 secret for local development only; replace it for real environments.
JWT_SECRET=c3VwZXItc2VjdXJlLWRldmVsb3BtZW50LWp3dC1rZXktYXQtbGVhc3QtMzItYnl0ZXM=
JWT_EXPIRATION_MINUTES=120
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10MB
MAX_REQUEST_SIZE=10MB
